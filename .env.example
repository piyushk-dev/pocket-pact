# API only. Never add VITE_ prefixes to secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SARVAM_API_KEY=
# Leave DATABASE_URL empty to use persistent local PGlite in .data/postgres.
DATABASE_URL=
DATA_DIR=.data
API_HOST=127.0.0.1
API_PORT=3001
# Comma-separated browser origins permitted to write to the API.
APP_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
